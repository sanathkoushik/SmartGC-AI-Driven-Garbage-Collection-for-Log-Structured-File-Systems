# Build directories
build/
bin/
*.obj
*.o
*.exe
*.out
*.app
*.dSYM/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Python / ML artifacts
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
*.pt
*.pth
*.pkl

# Trained model artifacts + fitted scaler (regenerated by ml/training + ml/preprocessing)
ml/models/*/
ml/models/scaler.json

# Raw and generated large datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/predictions/*
!data/predictions/.gitkeep

# Results & logs
results/metrics/*
!results/metrics/.gitkeep
# Headline benchmark artefacts are versioned (expensive to regenerate: a full
# run_matrix is ~30-40 min). Everything else under results/ stays ignored.
!results/metrics/matrix_results.csv
!results/metrics/op_sweep.csv
!results/metrics/model_cost.csv
!results/metrics/trace_stats_financial1.csv
!results/metrics/trace_stats_financial1_hist.csv
!results/metrics/robustness_sweep.csv
!results/metrics/seed_robustness.csv
!results/metrics/seed_robustness_summary.csv
results/plots/*
!results/plots/.gitkeep
!results/plots/ladder_waf.png
!results/plots/real_ladder_waf.png
!results/plots/waf_vs_op.png
!results/plots/gc_migration_tail.png
!results/plots/drift_timeline.png
!results/plots/accuracy_vs_cost.png
!results/plots/robustness_tradeoff.png
!results/plots/seed_robustness.png
*.log

